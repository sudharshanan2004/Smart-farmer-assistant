# ==========================================
# HarvestID Backend Environment Variables
# ==========================================

# Server Port (default: 5000)
PORT=5000

# ------------------------------------------
# MongoDB (Local or Atlas)
# ------------------------------------------
# For Localhost MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/harvest_id
# For MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/harvest_id?retryWrites=true&w=majority

# ------------------------------------------
# Google Gemini AI (Multilingual Assistant)
# ------------------------------------------
# Get your free API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here
# Optional model override (defaults: gemini-2.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Supabase (Optional / Fallback Storage)
# ------------------------------------------
# Project URL and public anon key from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
